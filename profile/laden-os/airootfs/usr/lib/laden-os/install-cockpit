#!/bin/bash
# SPDX-License-Identifier: MIT
# Install published The CockPit 1.1.0 inside the image build.
# Intel capture is not started. The example SSH list stays commented out.
# This script is for the image root, not the build machine.
set -euo pipefail

tarball=/usr/share/laden-os/src/the-cockpit-1.1.0-linux-x86_64.tar.gz
expected=72349d6983827d6a50acbdb5850b46aaa30213e9ecc8bb89f1e57c1d00943eb1

if [[ ! -f $tarball ]]; then
    echo "CockPit tarball is missing." >&2
    exit 1
fi
got=$(sha256sum "$tarball" | awk '{print $1}')
if [[ $got != "$expected" ]]; then
    echo "CockPit tarball hash does not match the published 1.1.0 hash." >&2
    exit 1
fi
if ! id live >/dev/null 2>&1; then
    echo "The live user does not exist yet." >&2
    exit 1
fi
if ! command -v wezterm >/dev/null 2>&1; then
    echo "wezterm is not installed." >&2
    exit 1
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
tar -xzf "$tarball" -C "$work"
src=$work/the-cockpit-1.1.0-linux-x86_64
if [[ $(tr -d '[:space:]' <"$src/VERSION") != 1.1.0 ]]; then
    echo "CockPit VERSION is not 1.1.0." >&2
    exit 1
fi

# HOME selects the config directory. --prefix /usr puts the program on the default path.
# --no-bundled uses the Arch wezterm package instead of the bundled AppImage.
HOME=/home/live XDG_CONFIG_HOME=/home/live/.config \
    bash "$src/install.sh" --prefix /usr --no-bundled

chown -R live:live /home/live/.config/the-cockpit
# The live account is created before this hook, so install.sh keeps an existing
# local.lua. Replace it with the Laden OS size and palette.
laden_local=/etc/skel/.config/the-cockpit/local.lua
if [[ ! -f $laden_local ]]; then
    echo "Laden OS CockPit local.lua is missing." >&2
    exit 1
fi
install -m 644 -o live -g live "$laden_local" /home/live/.config/the-cockpit/local.lua
# An uncommented table entry would be an SSH target. The published example has none.
if grep -E '^[[:space:]]*\{' /home/live/.config/the-cockpit/connections.lua | grep -q .; then
    echo "connections.lua contains an active SSH entry." >&2
    exit 1
fi
ln -sfn /usr/bin/cockpit /usr/bin/lcp
# One menu entry. lcp.desktop is the Laden OS launcher; Alt+T and Alt+Q use it.
rm -f /usr/share/applications/the-cockpit.desktop
rm -rf /root/.config/the-cockpit /usr/share/laden-os/src
if [[ ! -x /usr/bin/lcp || ! -x /usr/bin/cockpit ]]; then
    echo "CockPit launcher was not installed." >&2
    exit 1
fi
echo "CockPit 1.1.0 installed as lcp. Intel capture is not started."
