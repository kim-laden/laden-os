#!/bin/bash
# SPDX-License-Identifier: MIT
# Brand the image without claiming to be Arch Linux.
set -euo pipefail

cat >/usr/lib/os-release <<'EOF'
NAME="Laden OS"
PRETTY_NAME="Laden OS 0.1.3-live (based on Arch Linux)"
ID=ladenos
ID_LIKE=arch
VERSION="0.1.3-live"
VERSION_ID=0.1.3-live
VERSION_CODENAME=live
HOME_URL="https://laden.no/"
DOCUMENTATION_URL="file:///usr/share/doc/laden-os/welcome.html"
LOGO=ladenos
ANSI_COLOR="0;32"
EOF
ln -sfn ../usr/lib/os-release /etc/os-release
printf '%s\n' 'Laden OS \r (\l)' >/etc/issue
printf '%s\n' 'laden-os' >/etc/hostname
ln -sfn /usr/share/zoneinfo/UTC /etc/localtime
printf '%s\n' 'LANG=en_US.UTF-8' >/etc/locale.conf
printf '%s\n' 'en_US.UTF-8 UTF-8' >/etc/locale.gen
locale-gen
