#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Report the primary output and the largest enabled output.

Reads kscreen JSON from --json or from `kscreen-doctor -j`.
Connector names are taken only from that JSON. None are hard-coded.
"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys


def pixels(output: dict) -> int:
    size = output.get("size") or {}
    try:
        return int(size.get("width") or 0) * int(size.get("height") or 0)
    except (TypeError, ValueError):
        return 0


def choose(payload: dict) -> tuple[dict | None, dict | None]:
    outputs = payload.get("outputs") or []
    usable = [
        item
        for item in outputs
        if item.get("connected", True) and item.get("enabled", True)
    ]
    if not usable:
        return None, None
    primary = next((item for item in usable if item.get("priority") == 1), usable[0])
    largest = max(usable, key=pixels)
    return primary, largest


def load_payload(path: str | None) -> dict:
    if path:
        with open(path, encoding="utf-8") as handle:
            return json.load(handle)
    completed = subprocess.run(
        ["kscreen-doctor", "-j"],
        check=True,
        capture_output=True,
        text=True,
    )
    return json.loads(completed.stdout)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--json", help="Read kscreen JSON from a file instead of the live session")
    args = parser.parse_args()
    primary, largest = choose(load_payload(args.json))
    if primary is None or largest is None:
        print("primary=")
        print("largest=")
        return 0
    print(f"primary={primary.get('name', '')}")
    print(f"primary_pixels={pixels(primary)}")
    print(f"largest={largest.get('name', '')}")
    print(f"largest_pixels={pixels(largest)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
