+/** Laden OS lists disks that must never be install targets.
+ *  The file is written by laden-install. If it is missing or unreadable,
+ *  every disk is refused.
+ */
+static bool
+isLadenProtected( const Device* device )
+{
+    QFile file( QStringLiteral( "/run/laden-os/install-ignored" ) );
+    if ( !file.exists() || !file.open( QIODevice::ReadOnly | QIODevice::Text ) )
+    {
+        cWarning() << "Laden OS install guard missing. Refusing" << device->deviceNode();
+        return true;
+    }
+    const QString node = device->deviceNode();
+    while ( !file.atEnd() )
+    {
+        const QString line = QString::fromUtf8( file.readLine() ).trimmed();
+        if ( line.isEmpty() || line.startsWith( QLatin1Char( '#' ) ) )
+        {
+            continue;
+        }
+        if ( line == node )
+        {
+            return true;
+        }
+    }
+    return false;
+}
