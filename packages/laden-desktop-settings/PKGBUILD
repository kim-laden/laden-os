# Maintainer: Laden OS Repo <admin@laden.no>
pkgname=laden-desktop-settings
pkgver=2026.11.09
pkgrel=5
pkgdesc='Laden OS KDE Plasma look-and-feel, color scheme, XDG defaults and fish config'
arch=('any')
url='https://laden.no'
license=('LicenseRef-LadenAS')
depends=('laden-branding' 'bash')
optdepends=('plasma-desktop: Laden look-and-feel'
            'fish: Laden shell config'
            'laden-update: Laden Update tray updater')
backup=('etc/xdg/kdeglobals' 'etc/xdg/ksplashrc')
source=('laden-config.fish' 'laden-colors.fish' 'laden-os.fish'
        '00-laden-config.fish' 'compat-laden-config.fish')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

_assets="${startdir}/../../rebrand/assets"

package() {
  local d="${pkgdir}"

  # Plasma look-and-feel + colors
  install -dm0755 "${d}/usr/share/plasma/look-and-feel/org.laden.os"
  cp -a --no-preserve=ownership "${_assets}/look-and-feel/org.laden.os/." \
    "${d}/usr/share/plasma/look-and-feel/org.laden.os/"
  # contents/layouts/ belongs to laden-menu (desktop + panel layout); never ship it here
  rm -rf "${d}/usr/share/plasma/look-and-feel/org.laden.os/contents/layouts"
  find "${d}/usr/share/plasma" -type f -exec chmod 0644 {} +
  install -Dm0644 "${_assets}/LadenDark.colors" "${d}/usr/share/color-schemes/LadenDark.colors"

  # XDG defaults for new users / fallbacks
  install -Dm0644 "${_assets}/xdg/kdeglobals" "${d}/etc/xdg/kdeglobals"
  install -Dm0644 "${_assets}/xdg/ksplashrc"  "${d}/etc/xdg/ksplashrc"

  # fish
  install -Dm0644 laden-config.fish "${d}/usr/share/laden/fish/laden-config.fish"
  install -Dm0644 laden-colors.fish "${d}/usr/share/laden/fish/laden-colors.fish"
  install -Dm0644 compat-laden-config.fish "${d}/usr/share/laden-os/fish/laden-config.fish"
  install -Dm0644 00-laden-config.fish "${d}/etc/fish/conf.d/00-laden-config.fish"
  install -Dm0644 laden-colors.fish   "${d}/etc/fish/conf.d/laden-colors.fish"
  install -Dm0644 laden-os.fish       "${d}/etc/fish/conf.d/laden-os.fish"

  # Generic Laden Update icon (the tray itself now comes from the laden-update
  # package; the old cachy-update overlay hook and menu overrides were dropped
  # in 2026.11.09-2 because laden-update / laden-kernel-manager /
  # laden-scheduler ship Laden-named entries themselves).
  install -Dm0644 "${_assets}/icons/tray/laden-update.svg" "${d}/usr/share/icons/hicolor/scalable/apps/laden-update.svg"
}
