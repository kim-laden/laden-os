#!/usr/bin/env bash
# Laden OS: overlay Laden branding on cachy-update's tray autostart entry and
# icons (files owned by cachy-update, so they are overlaid, not claimed).
# The update tool itself (arch-update / cachy-update) is untouched.
set -u
SHARE=/usr/share/laden/overrides
ORIG=/var/lib/laden/orig
put() {
  local src=$1 dest=$2
  [[ -f $src && -e $dest ]] || return 0
  cmp -s "$src" "$dest" && return 0
  if [[ ! -e $ORIG$dest ]]; then mkdir -p "$(dirname "$ORIG$dest")"; cp -a "$dest" "$ORIG$dest"; fi
  install -m0644 "$src" "$dest"
  logger -t laden-desktop-settings "applied $dest" 2>/dev/null || true
}
put "$SHARE/arch-update-tray.autostart.desktop" /etc/xdg/autostart/arch-update-tray.desktop
for f in /usr/share/icons/hicolor/scalable/apps/cachy-update*.svg; do
  [[ -e $f ]] && put /usr/share/icons/hicolor/scalable/apps/laden-update.svg "$f"
done
command -v gtk-update-icon-cache >/dev/null && gtk-update-icon-cache -qf /usr/share/icons/hicolor 2>/dev/null
exit 0
