# Laden OS command colors. Truecolor, so a command is not the same green as its output.
# Pearl body, neon command, gold strings, sky paths, cyan pipes, coral errors.
set -g fish_color_normal '#d7f6ea'
set -g fish_color_command '#00ff9d' --bold
set -g fish_color_keyword '#c9a6ff' --bold
set -g fish_color_builtin '#5dffc0' --bold
set -g fish_color_function '#8cffc8' --bold
set -g fish_color_param '#f4fff9'
set -g fish_color_option '#c6ff4a'
set -g fish_color_quote '#e6d36a'
set -g fish_color_redirection '#3df0ff' --bold
set -g fish_color_end '#3df0ff' --bold
set -g fish_color_operator '#7af0ff' --bold
set -g fish_color_error '#ff5c7a' --bold
set -g fish_color_comment '#6d9a86' --italics
set -g fish_color_escape '#c6ff4a'
set -g fish_color_autosuggestion '#3d6a54'
set -g fish_color_valid_path '#6ec8ff' --underline
set -g fish_color_cwd '#6ec8ff'
set -g fish_color_cwd_root '#ff5c7a'
set -g fish_color_user '#00ff9d' --bold
set -g fish_color_host '#3df0ff'
set -g fish_color_host_remote '#e6d36a'
set -g fish_color_status '#ff5c7a'
set -g fish_color_cancel '#ff5c7a'
set -g fish_color_search_match --background '#145c3a'
set -g fish_color_selection --background '#145c3a'
set -g fish_color_history_current '#00ff9d' --bold
set -g fish_pager_color_prefix '#00ff9d' --bold
set -g fish_pager_color_completion '#f4fff9'
set -g fish_pager_color_description '#6d9a86'
set -g fish_pager_color_progress '#3df0ff'
set -g fish_pager_color_selected_background --background '#145c3a'
set -g fish_pager_color_selected_prefix '#00ff9d' --bold
set -g fish_pager_color_selected_completion '#f4fff9'
set -g fish_pager_color_selected_description '#d7f6ea'
