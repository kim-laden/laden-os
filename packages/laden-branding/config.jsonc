// Laden OS fastfetch defaults (package laden-branding).
// Per-user override: ~/.config/fastfetch/config.jsonc
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/laden/fastfetch/logo.txt",
    "color": { "1": "38;2;57;255;176", "2": "97" },
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "color": { "keys": "38;2;57;255;176", "title": "38;2;57;255;176" },
    "separator": "  "
  },
  "modules": [
    "title", "separator",
    "os", "host", "kernel", "uptime", "packages", "shell",
    "display", "de", "wm", "wmtheme", "theme", "icons", "font", "cursor",
    "terminal", "terminalfont", "cpu", "gpu", "memory", "swap", "disk",
    "localip", "battery", "poweradapter", "locale",
    "break", "colors"
  ]
}
