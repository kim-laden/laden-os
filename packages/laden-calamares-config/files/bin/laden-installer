#!/bin/bash
# Start the Laden OS installer (Calamares) from the live session.
if ! grep -qw avx2 /proc/cpuinfo || ! grep -qw bmi2 /proc/cpuinfo; then
    msg="Laden OS 1.0.0 needs an x86-64-v3 CPU (AVX2), like Intel Haswell / AMD Zen or newer."
    command -v kdialog >/dev/null && kdialog --error "$msg" || echo "$msg" >&2
    exit 1
fi
log=/tmp/laden-installer.log
# BIOS boot: Limine needs a FAT32 /boot. Also applied at live boot by
# laden-firmware-partition.service so a direct calamares launch still works.
if [[ -x /usr/lib/laden-installer/apply-firmware-partition-config ]]; then
    sudo /usr/lib/laden-installer/apply-firmware-partition-config
fi
# Calamares runs as root. Give it the KDE platform theme and let it read (not
# write) the live user's colour scheme, so the installer is dark and readable.
export QT_QPA_PLATFORMTHEME="${QT_QPA_PLATFORMTHEME:-kde}"
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-KDE}" KDE_FULL_SESSION=true KDE_SESSION_VERSION=6
export XDG_CONFIG_DIRS="$HOME/.config:${XDG_CONFIG_DIRS:-/etc/xdg}"
exec sudo --preserve-env=WAYLAND_DISPLAY,XDG_RUNTIME_DIR,DISPLAY,XAUTHORITY,QT_QPA_PLATFORM,XDG_SESSION_TYPE,QT_QPA_PLATFORMTHEME,XDG_CURRENT_DESKTOP,KDE_FULL_SESSION,KDE_SESSION_VERSION,XDG_CONFIG_DIRS \
    /usr/bin/calamares "$@" >"$log" 2>&1
