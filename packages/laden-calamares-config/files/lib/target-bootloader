#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Runs in the target after the Calamares bootloader module.
# Limine: name the menu "Laden OS", replace limine-entry-tool with the
# mkinitcpio hook (so kernel updates refresh the menu), and on BIOS install
# limine-bios.sys plus the MBR/VBR stages.
set -euo pipefail
log() { echo "laden-installer: $*"; }

conf=""
for c in /boot/limine.conf /boot/limine/limine.conf /boot/EFI/limine/limine.conf; do
    [[ -f $c ]] && conf=$c && break
done
if [[ -z $conf ]]; then
    if [[ ! -d /sys/firmware/efi ]]; then
        # systemd-boot is UEFI-only, so a BIOS install must have Limine on /boot.
        log "ERROR: BIOS install but no limine.conf on /boot (found: $(ls /boot/efi/limine.conf 2>/dev/null || echo none))"
        exit 1
    fi
    log "no limine.conf: systemd-boot install, nothing to do"
    exit 0
fi

sed -i -e 's|^/+CachyOS$|/+Laden OS|' \
       -e 's|^# CachyOS Limine theme$|# Laden OS Limine theme|' \
       -e '/^# Author: diegons490/d' \
       -e 's|^interface_branding:.*|interface_branding: Laden OS|' \
       -e 's|^term_palette: .*|term_palette: 050b09;ff5f5f;39ffb0;f9e2af;5fafff;f5c2e7;94e2d5;e9fff5|' \
       -e 's|^term_foreground: .*|term_foreground: e9fff5|' "$conf"

# Point both limine-entry-tool and limine-mkinitcpio-hook at the Laden OS
# entry and at /boot (ESP on UEFI, FAT32 boot partition on BIOS). The hook
# ignores /proc/cmdline in a chroot and writes no kernel entries unless
# KERNEL_CMDLINE (or /etc/kernel/cmdline) is set. Written here so it survives
# removal of the installer package.
write_limine_defaults() {
    local uuid fstype opts src subvol="" cmdline
    uuid=$(findmnt -no UUID / 2>/dev/null || true)
    fstype=$(findmnt -no FSTYPE / 2>/dev/null || true)
    opts=$(findmnt -no OPTIONS / 2>/dev/null || true)
    src=$(findmnt -no SOURCE / 2>/dev/null || true)
    src=${src%%[*}
    if [[ -z $uuid && -n $src ]]; then
        uuid=$(blkid -s UUID -o value "$src" 2>/dev/null || true)
        fstype=$(blkid -s TYPE -o value "$src" 2>/dev/null || true)
    fi
    if [[ -z $uuid && -f /etc/fstab ]]; then
        uuid=$(awk '$2=="/" && $1 ~ /^UUID=/ { print substr($1, 6); exit }' /etc/fstab)
        fstype=$(awk '$2=="/" { print $3; exit }' /etc/fstab)
        opts=$(awk '$2=="/" { print $4; exit }' /etc/fstab)
    fi
    [[ -n $uuid ]] || { log "ERROR: cannot determine root UUID for Limine cmdline"; exit 1; }
    if [[ $fstype == btrfs ]]; then
        if [[ $opts =~ subvol=([^,]+) ]]; then
            subvol=${BASH_REMATCH[1]}
        elif [[ $src =~ \[(.*)\] ]]; then
            subvol=${BASH_REMATCH[1]}
        else
            subvol=/@
        fi
        [[ $subvol == @* ]] && subvol=/$subvol
    fi
    cmdline="quiet nowatchdog splash loglevel=3 rw"
    [[ -n $subvol ]] && cmdline+=" rootflags=subvol=$subvol"
    cmdline+=" root=UUID=$uuid"
    if pacman -Qq nvidia-utils >/dev/null 2>&1 || pacman -Qq nvidia-open-dkms >/dev/null 2>&1; then
        cmdline+=" nvidia-drm.modeset=1 nvidia-drm.fbdev=1"
    fi
    install -d /etc/default /etc/kernel
    cat > /etc/default/limine << EOF
# Written by the Laden OS installer. Overrides /etc/limine-entry-tool.conf.
TARGET_OS_NAME="Laden OS"
ESP_PATH="/boot"
KERNEL_CMDLINE[default]+="$cmdline"
BOOT_ORDER="*, *fallback, Snapshots"
EOF
    printf '%s\n' "$cmdline" > /etc/kernel/cmdline
    log "wrote Limine cmdline: $cmdline"
}
write_limine_defaults

# Swap limine-entry-tool for limine-mkinitcpio-hook.
# pacman --noconfirm answers "no" to "remove the conflicting package?", so
# --ask 4 is not enough; remove the conflicting package first, then install
# the bundled hook offline. Never use pacman -Rns.
if ! pacman -Q limine-mkinitcpio-hook >/dev/null 2>&1; then
    pkg=""
    for f in /usr/share/laden-installer/pkgs/limine-mkinitcpio-hook-*.pkg.tar.zst; do
        [[ -f $f ]] && pkg=$f && break
    done
    [[ -n $pkg ]] || { log "ERROR: bundled limine-mkinitcpio-hook package missing"; exit 1; }
    # Only remove the real package, not a provider (the hook Provides the same name).
    inst=$(pacman -Qq limine-entry-tool 2>/dev/null || true)
    if [[ $inst == limine-entry-tool ]]; then
        log "removing conflicting limine-entry-tool"
        pacman -Rdd --noconfirm limine-entry-tool
    fi
    log "installing $pkg"
    pacman -U --noconfirm "$pkg"
    pacman -Q limine-mkinitcpio-hook >/dev/null
fi

# BIOS: Limine stage 1/2 go on the disk; stage 3 (limine-bios.sys) must sit
# on a FAT filesystem Limine can read (/boot).
if [[ ! -d /sys/firmware/efi ]]; then
    datadir=$(limine --print-datadir)
    [[ -f $datadir/limine-bios.sys ]] || { log "ERROR: $datadir/limine-bios.sys missing"; exit 1; }
    install -Dm0644 "$datadir/limine-bios.sys" /boot/limine-bios.sys
    install -Dm0644 "$datadir/limine-bios.sys" /boot/limine/limine-bios.sys
    bootdev=$(findmnt -no SOURCE /boot 2>/dev/null || findmnt -no SOURCE /)
    pk=$(lsblk -no PKNAME "$bootdev" 2>/dev/null | head -1)
    if [[ -z $pk && -b $bootdev && $(lsblk -no TYPE "$bootdev") == disk ]]; then
        pk=${bootdev#/dev/}
    fi
    [[ -n $pk && -b /dev/$pk ]] || { log "ERROR: cannot find disk for limine bios-install (bootdev=$bootdev)"; exit 1; }
    log "limine bios-install /dev/$pk"
    limine bios-install "/dev/$pk"
fi

# Kernels live in the ESP / FAT /boot under the machine-id once the hook is in place.
rm -f /boot/vmlinuz-linux-laden /boot/initramfs-linux-laden.img /boot/initramfs-linux-laden-fallback.img
limine-update

# limine-entry-tool / the hook may add "/+Laden OS <version>". Drop the empty
# "/+Laden OS" folder the bootloader module wrote, otherwise default_entry
# lands on a folder and the menu never boots on its own.
if grep -q '^/+Laden OS .' "$conf"; then
    sed -i '/^\/+Laden OS$/d' "$conf"
fi
# Re-resolve conf in case limine-update rewrote a canonical path.
for c in /boot/limine.conf /boot/limine/limine.conf /boot/EFI/limine/limine.conf; do
    [[ -f $c ]] && conf=$c && break
done
grep -q 'linux-laden' "$conf" || { log "ERROR: no linux-laden entry in $conf"; exit 1; }

if [[ ! -d /sys/firmware/efi ]]; then
    # Limine BIOS reads limine.conf, limine-bios.sys and the kernels from the
    # same FAT partition, so they must all be on the /boot filesystem.
    # limine-update copies it to /boot/<machine-id>/linux-laden/vmlinuz.
    if ! find /boot -maxdepth 3 \( -path "*/linux-laden/vmlinuz" -o -name vmlinuz-linux-laden \) | grep -q .; then
        log "ERROR: no linux-laden kernel on /boot after limine-update"
        exit 1
    fi
    if [[ ! -f /boot/limine-bios.sys && ! -f /boot/limine/limine-bios.sys ]]; then
        log "ERROR: limine-bios.sys missing from /boot after install"
        exit 1
    fi
fi
log "limine menu ready"
