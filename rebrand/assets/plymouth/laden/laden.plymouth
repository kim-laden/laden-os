[Plymouth Theme]
Name=laden
Description=Laden OS boot splash — Let's do it!
ModuleName=two-step

[two-step]
Font=Inter 12
TitleFont=Inter Bold 28
ImageDir=/usr/share/plymouth/themes/laden
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.5
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.40
HorizontalAlignment=.5
VerticalAlignment=.55
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x050807
BackgroundEndColor=0x050807
ProgressBarBackgroundColor=0x1a2e28
ProgressBarForegroundColor=0x39ffb0
MessageColor=0xf4fff9
TitleColor=0xf4fff9

[boot-up]
UseEndAnimation=false
UsePasswordBox=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false

[updates]
UseEndAnimation=false
